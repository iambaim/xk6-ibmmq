* Test-only responder using IBM MQ's sample echo program.
DEFINE QLOCAL('DEV.XK6.REPLY') REPLACE
DEFINE QLOCAL('DEV.XK6.NO.RESPONDER') REPLACE
DEFINE QLOCAL('XK6.TEST.INITQ') REPLACE
DEFINE PROCESS('XK6.TEST.ECHO') APPLTYPE(UNIX) APPLICID('/opt/mqm/samp/bin/amqsech') REPLACE
DEFINE QLOCAL('DEV.XK6.REQUEST') TRIGGER TRIGTYPE(FIRST) INITQ('XK6.TEST.INITQ') +
  PROCESS('XK6.TEST.ECHO') REPLACE
DEFINE SERVICE('XK6.TEST.TRIGGER') CONTROL(QMGR) SERVTYPE(SERVER) +
  STARTCMD('/opt/mqm/bin/runmqtrm') STARTARG('-m +QMNAME+ -q XK6.TEST.INITQ') REPLACE
